{
  "name": "cratesmove",
  "description": "CS2 Storage Unit Manager",
  "version": "0.12.1",
  "author": {
    "name": "ByMykel",
    "email": "bymykel5@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByMykel/cratesmove"
  },
  "private": true,
  "type": "module",
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "start": "node packages/dev-mode.js",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,vue}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@npmcli/map-workspaces": "6.0.0",
    "@types/node": "25.9.1",
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@app/main": "*",
    "@tanstack/vue-virtual": "^3.13.26",
    "cs2-inventory-resolver": "^0.3.7",
    "vue-eslint-parser": "^10.4.0"
  }
}
